# College Academic Schedule Planner - frontend environment
#
# Copy this file to `.env.local` and adjust values for your machine.
# `.env.local` is git-ignored and must never be committed.
#
# IMPORTANT
# - Only variables prefixed with `NEXT_PUBLIC_` are exposed to browser code.
# - BACKEND_API_URL is intentionally NOT public: the browser talks to the
#   Next.js same-origin BFF routes under /api/*, never to Django directly.
# - Never place JWT secrets, cookie secrets or internal infrastructure URLs in a
#   NEXT_PUBLIC_* variable.

# Base URL of the Django REST API (Backend API v1.0.0).
# Development default: http://127.0.0.1:8000
# No trailing slash is required; a trailing slash is stripped.
BACKEND_API_URL=http://127.0.0.1:8000
